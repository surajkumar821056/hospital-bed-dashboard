# Optional when the API is hosted separately. Leave unset to use Vite's /api proxy.
# VITE_API_URL=https://api.example.com/api

# Required for Docker Compose production deployment. Replace these values.
ADMIN_EMAIL=admin@medresq.gov
ADMIN_PASSWORD=
DATABASE_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Local Java startup uses environment variables set in PowerShell, not this file.
DATABASE_URL=jdbc:mysql://localhost:3306/medresq
DATABASE_USER=medresq
